From 27ed8ede2a25130244d637acdfe30ae94f30ba0c Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sun, 8 Nov 2026 16:14:48 -0500
Subject: [PATCH] Add the J713 (MacBook Air 13", M4)

Four SN012776 amps (two woofers, two tweeters) at amp gain 15, like the
J413/J613. The J713 amps send V before I, so the sense channel pairs are
swapped relative to the J413.

The ADT has no speaker thermal parameters and the J713 macOS preset has
not been decoded, so use the J413/J613 values with t_limit 10 C lower
(130 C) on every speaker until it is.

Start the daemon for the AppleJ713 card.
---
 95-speakersafetyd.rules |  1 +
 conf/apple/j713.conf    | 95 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 96 insertions(+)
 create mode 100644 conf/apple/j713.conf

diff --git a/95-speakersafetyd.rules b/95-speakersafetyd.rules
index 364270b..9e322d4 100644
--- a/95-speakersafetyd.rules
+++ b/95-speakersafetyd.rules
@@ -29,5 +29,6 @@ KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ516", TAG+="systemd", ENV{SYSTEMD_WANTS}="
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ575", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ613", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ615", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
+KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ713", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 
 LABEL="speakersafetyd_end"
diff --git a/conf/apple/j713.conf b/conf/apple/j713.conf
new file mode 100644
index 0000000..7182fb8
--- /dev/null
+++ b/conf/apple/j713.conf
@@ -0,0 +1,95 @@
+# J713 (MacBook Air 13", M4): four SN012776 amps, two woofers and two
+# tweeters, amp gain 15 (ADT speaker-config), like the J413/J613.
+#
+# The ADT carries the amp setup but no speaker thermal parameters, and the J713
+# macOS speaker preset has not been decoded yet. Until it is, this profile uses
+# the J413/J613 values with a conservative margin: t_limit is 10 C below theirs
+# on every speaker (130 C instead of 140 C). That lowers the allowed power,
+# starts gain reduction earlier (110 C) and makes the daemon give up, which
+# locks the volume, at the old limit (140 C).
+#
+# Sense channels: the J713 amps send V before I (ADT vsense/isense slots 0/2,
+# 4/6, 8/10, 12/14; 8 x 16-bit channels in rx_slot order LW, RW, LT, RT).
+[Globals]
+visense_pcm = 2
+t_ambient = 50.0
+t_hysteresis = 5.0
+t_window = 20.0
+channels = 8
+period = 4096
+link_gains = True
+uclamp_max = 64
+
+[Controls]
+vsense = VSENSE Switch
+isense = ISENSE Switch
+amp_gain = Amp Gain Volume
+volume = Speaker Volume
+
+[Speaker/Left Woofer]
+group = 1
+tr_coil = 32.10
+tr_magnet = 20.00
+tau_coil = 4.70
+tau_magnet = 66.50
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 4.00
+z_shunt = 0.00
+a_t_20c = 0.00370036
+a_t_35c = 0.00351349
+is_scale = 3.75
+vs_scale = 14
+is_chan = 1
+vs_chan = 0
+
+[Speaker/Right Woofer]
+group = 1
+tr_coil = 32.10
+tr_magnet = 20.00
+tau_coil = 4.70
+tau_magnet = 66.50
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 4.00
+z_shunt = 0.00
+a_t_20c = 0.00370036
+a_t_35c = 0.00351349
+is_scale = 3.75
+vs_scale = 14
+is_chan = 3
+vs_chan = 2
+
+[Speaker/Left Tweeter]
+group = 0
+tr_coil = 104.90
+tr_magnet = 200.0
+tau_coil = 1.85
+tau_magnet = 70.00
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.72
+z_shunt = 0.00
+a_t_20c = 0.00371053
+a_t_35c = 0.00350437
+is_scale = 3.75
+vs_scale = 14
+is_chan = 5
+vs_chan = 4
+
+[Speaker/Right Tweeter]
+group = 0
+tr_coil = 104.90
+tr_magnet = 200.0
+tau_coil = 1.85
+tau_magnet = 70.00
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.72
+z_shunt = 0.00
+a_t_20c = 0.00371053
+a_t_35c = 0.00350437
+is_scale = 3.75
+vs_scale = 14
+is_chan = 7
+vs_chan = 6
-- 
2.55.0

