# Apple 16K kernels (kernel-16k, kernel-16k-debug): what the M4 needs on top of
# Fedora's configuration. Generated against the tested Gravity configuration:
# every option it enables stays enabled, the Apple platform stays built in,
# and generic drivers stay modules as Fedora has them, except built-in uinput. The debug variant uses
# KASAN with GCC, which rules out Rust there (no Asahi GPU, AOP, SEP or PMP).

# P3S (4K processes on the 16K kernel) needs 3-level 47-bit page tables and no
# AArch32 compat (Apple cores have no AArch32 EL0 anyway).
CONFIG_ARM64_PER_PROCESS_PAGE_SIZE=y
CONFIG_ARM64_VA_BITS=47
CONFIG_ARM64_VA_BITS_47=y
CONFIG_ARM64_VA_BITS_48=n
CONFIG_COMPAT=n

# Graphics and display: the Asahi GPU driver (Rust) and the DCP display driver,
# built in with the helpers they need.
CONFIG_BACKLIGHT_APPLE_DWI=m
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_DRM_APPLE_DEBUG=n
CONFIG_DRM_APPLE=y
CONFIG_DRM_ASAHI_DEBUG_ALLOCATOR=n
CONFIG_DRM_ASAHI=y
CONFIG_MUX_APPLE_DPXBAR=m
CONFIG_PHY_APPLE_DPTX=y
CONFIG_RUST_DRM_GEM_SHMEM_HELPER=y
CONFIG_RUST_DRM_GPUVM=y
CONFIG_RUST_DRM_SCHED=y

# Internal storage: Apple ANS NVMe and the NVMe core it sits on.
CONFIG_APPLE_SART=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_NVME_AUTH=y
CONFIG_NVME_KEYRING=y

# Sound: the core and the Apple speaker, jack and microphone paths are built in
# (as in the tested kernel); USB and other sound devices stay modules.
CONFIG_APPLE_ADMAC=y
CONFIG_COMMON_CLK_APPLE_NCO=y
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
CONFIG_SND_SOC_APPLE_AOP_SPEAKER_CODECS=n
CONFIG_SND_SOC_APPLE_J713_HEADPHONES=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_SND_SOC_APPLE_NEO_MIC=y
CONFIG_SND_SOC_APPLE_NEO_SPEAKER=y
CONFIG_SND_SOC_APPLE_T8132_SPEAKER=y
CONFIG_SND_SOC_CS42L84=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC=y
CONFIG_SND=y
CONFIG_SOUND=y

# USB and USB-C/USB4: DWC3 in dual-role mode (needs the gadget core built in),
# the Apple Type-C PHY and port controllers.
CONFIG_PHY_APPLE_ATC=y
CONFIG_RESET_APPLE_CIO=y
CONFIG_TYPEC_SN201202X=y
CONFIG_TYPEC=y
CONFIG_USB4_APPLE_SOC=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_DWC3=y
CONFIG_USB_GADGET=y
CONFIG_USB_ULPI_BUS=y
CONFIG_USB_XHCI_PLATFORM=y

# Apple platform: power, cpufreq/cpuidle, SMC, DART, mailbox/RTKit, DockChannel
# (keyboard and trackpad on the laptops), radios' companion drivers, camera and
# video decode.
CONFIG_APPLE_AOP=m
CONFIG_APPLE_DART=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_PMP=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SEP=m
CONFIG_APPLE_SIO=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_ARM_APPLE_M4_CPUIDLE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_BT_BRCMEXT=y
CONFIG_BT_HCIMT793B=m
CONFIG_GPIO_MACSMC=y
CONFIG_HID_APPLE=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_I2C_APPLE=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_INPUT_UINPUT=y
CONFIG_MACSMC_POWER=y
CONFIG_MFD_MACSMC=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_PWM_APPLE=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_RUST_APPLE_MAILBOX=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_SPI_HID_APPLE_CORE=m
CONFIG_SPI_HID_APPLE_OF=m
CONFIG_SPMI_APPLE=y
CONFIG_V4L2_H264=m
CONFIG_V4L2_VP9=m
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_ISP=m

# Other choices carried over from the tested kernel: /proc/config.gz, lz4 zram,
# the PCIe power-saving ASPM policy, and newly visible menu and driver options.
CONFIG_DINGHAI=n
CONFIG_IKCONFIG_PROC=y
CONFIG_IKCONFIG=y
CONFIG_MM81X_SDIO=n
CONFIG_MM81X_USB=n
CONFIG_NET_VENDOR_ZTE=y
CONFIG_PCIEASPM_DEFAULT=n
CONFIG_PCIEASPM_POWER_SUPERSAVE=y
CONFIG_VMAP_PFN=y
CONFIG_WLAN_VENDOR_MORSEMICRO=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZORLE=n
