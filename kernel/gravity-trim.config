# Apple 16K kernels only. Keep Apple generations and generic external devices.
# These graphics devices are outside our supported hardware (including eGPUs).
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_I915=n
CONFIG_DRM_XE=n
CONFIG_DRM_ETNAVIV=n
CONFIG_DRM_LIMA=n
CONFIG_DRM_PANFROST=n
CONFIG_DRM_PANTHOR=n
CONFIG_DRM_MSM=n
CONFIG_DRM_TEGRA=n
CONFIG_DRM_ROCKCHIP=n
CONFIG_DRM_MESON=n
CONFIG_DRM_VC4=n
CONFIG_DRM_V3D=n
# Previously selected by Tegra machine drivers; explicit for Fedora config checks.
CONFIG_SND_SOC_RT5640=n

# Unrelated ARM SoCs. Keep VEXPRESS/virt support for QEMU debugging.
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# Without the removed built-in SoC users, remaining consumers are modules.
CONFIG_REGMAP_SPMI=m
CONFIG_QCOM_SCM=m
