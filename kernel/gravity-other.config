# Every non-AArch64 Fedora variant (x86_64, ppc64le, riscv64, s390x): Fedora's
# %prep processes them too, so options the Gravity source adds outside the
# Apple-only menus need a value there. All are off, as their Kconfig defaults.
CONFIG_BT_BRCMEXT=n
CONFIG_BT_HCIMT793B=n
CONFIG_SPI_HID_APPLE_OF=n
CONFIG_USB_XHCI_PCI_ASMEDIA=n
