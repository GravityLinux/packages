# Fedora validates every AArch64 variant, including debug and RT, in %prep.
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
# Options the Gravity source adds, at their Kconfig defaults except the Apple
# PMP power driver, which is off. Outside the 16K kernels most of them depend on
# Apple drivers that are not built there.
CONFIG_APPLE_AOP=n
CONFIG_APPLE_DOCKCHANNEL=n
CONFIG_APPLE_PMP_REPORT=n
CONFIG_APPLE_PMP=n
CONFIG_APPLE_RTKIT_HELPER=n
CONFIG_APPLE_SEP=n
CONFIG_APPLE_SIO=n
CONFIG_ARM64_MEMORY_MODEL_CONTROL=n
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_ARM_APPLE_M4_CPUIDLE=n
CONFIG_BT_BRCMEXT=n
CONFIG_BT_HCIMT793B=n
CONFIG_DRM_APPLE=n
CONFIG_IIO_AOP_SENSOR_ALS=n
CONFIG_IIO_AOP_SENSOR_LAS=n
CONFIG_INPUT_MACSMC_INPUT=n
CONFIG_MUX_APPLE_DPXBAR=n
CONFIG_PHY_APPLE_DPTX=n
CONFIG_RESET_APPLE_CIO=n
CONFIG_SND_SOC_APPLE_AOP_AUDIO=n
CONFIG_SND_SOC_APPLE_MACAUDIO=n
CONFIG_SND_SOC_APPLE_NEO_MIC=n
CONFIG_SPI_HID_APPLE_OF=n
CONFIG_TYPEC_SN201202X=n
CONFIG_USB4_APPLE_SOC=n
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_VIDEO_APPLE_AVD=n
CONFIG_VIDEO_APPLE_ISP=n
