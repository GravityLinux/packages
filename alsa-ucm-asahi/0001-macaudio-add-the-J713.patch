From dd9e76c6d4ac99d98f1ad135df949353bc3996ea Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sun, 8 Nov 2026 16:18:08 -0500
Subject: [PATCH] macaudio: add the J713 (MacBook Air 13", M4)

Four amps (two woofers, two tweeters) on PCM 1 like the J413/J613, and
the CS42L84 jack on PCM 0. The T8132 card has no headset capture yet, so
the J713 gets a headphone-only device. Its DAC sources are crossed: with
the J413 mapping the left channel played in the right ear. The crossed
mapping still needs a listen test.
---
 ucm2/conf.d/macaudio/MacBook Air J713.conf    | 11 +++++++++
 .../macaudio/cs42l84/Headphones-j713.conf     | 23 +++++++++++++++++++
 ucm2/conf.d/macaudio/laptops/HiFi.conf        | 11 +++++++++
 3 files changed, 45 insertions(+)
 create mode 100644 ucm2/conf.d/macaudio/MacBook Air J713.conf
 create mode 100644 ucm2/conf.d/macaudio/cs42l84/Headphones-j713.conf

diff --git a/ucm2/conf.d/macaudio/MacBook Air J713.conf b/ucm2/conf.d/macaudio/MacBook Air J713.conf
new file mode 100644
index 0000000..58c15cf
--- /dev/null
+++ b/ucm2/conf.d/macaudio/MacBook Air J713.conf	
@@ -0,0 +1,11 @@
+Syntax 6
+
+SectionUseCase."HiFi" {
+	Comment "Default"
+	Define.JackCodec "cs42l84-j713"
+	Define.PlaybackChannels "4"
+	Define.JackDevice "0"
+	Define.SpeakerDevice "1"
+	Define.SpeakerElem "Left Woofer Speaker Volume"
+	File "/conf.d/macaudio/laptops/HiFi.conf"
+}
diff --git a/ucm2/conf.d/macaudio/cs42l84/Headphones-j713.conf b/ucm2/conf.d/macaudio/cs42l84/Headphones-j713.conf
new file mode 100644
index 0000000..75c2e9c
--- /dev/null
+++ b/ucm2/conf.d/macaudio/cs42l84/Headphones-j713.conf
@@ -0,0 +1,23 @@
+# J713 (MacBook Air 13", M4): headphones only, the T8132 card has no headset
+# capture yet.
+#
+# The DAC sources cross: with DAC A on ASP RX CH1 the left channel played in
+# the right ear (J713 listen test, 2026-11-08). UNVERIFIED until a listen test
+# with this mapping.
+
+SectionDevice."Headphones" {
+	Comment "Headphones"
+
+	EnableSequence [
+		cset "name='Headphone Switch' on"
+		cset "name='Jack DACA Select' 'ASP RX CH2'"
+		cset "name='Jack DACB Select' 'ASP RX CH1'"
+	]
+
+	Value {
+		PlaybackPriority 300
+		PlaybackPCM "hw:${CardId},${var:JackDevice}"
+		JackControl "Headphone Jack"
+		PlaybackMixerElem "Jack DAC"
+	}
+}
diff --git a/ucm2/conf.d/macaudio/laptops/HiFi.conf b/ucm2/conf.d/macaudio/laptops/HiFi.conf
index 353f032..c940fdd 100644
--- a/ucm2/conf.d/macaudio/laptops/HiFi.conf
+++ b/ucm2/conf.d/macaudio/laptops/HiFi.conf
@@ -22,6 +22,17 @@ If.cs42l84 {
 	}
 }
 
+If.cs42l84j713 {
+	Condition {
+		Type String
+		String1 "${var:JackCodec}"
+		String2 "cs42l84-j713"
+	}
+	True {
+		Include.hp.File "/conf.d/macaudio/cs42l84/Headphones-j713.conf"
+	}
+}
+
 If.cs42l83 {
 	Condition {
 		Type String
-- 
2.55.0

