Name:           gravity-audio-j713
Version:        1
Release:        1.gravity%{?dist}
Vendor:         Gravity Linux
Summary:        Audio profiles for the MacBook Air 13" (M4, J713)
# UCM files follow alsa-ucm-conf-asahi (BSD-3-Clause); speakersafetyd profile
# and WirePlumber rules follow speakersafetyd and asahi-audio (MIT).
License:        MIT AND BSD-3-Clause
URL:            https://github.com/GravityLinux
Source0:        LICENSE
Source1:        LICENSE.alsa-ucm-conf-asahi
Source2:        README.md
Source10:       macaudio-j713.conf
Source11:       macaudio-j713-HiFi.conf
Source12:       macaudio-j713-Headphones.conf
Source13:       aop_audio-j713.conf
Source20:       wireplumber-j713.conf
Source30:       speakersafetyd-j713.conf
Source31:       95-speakersafetyd-j713.rules

BuildArch:      noarch
BuildRequires:  systemd-rpm-macros

# The J713 files plug into the directories and shared files of Fedora's
# packages: laptops/HiFi.conf and aop_audio/3chan/HiFi.conf (alsa-ucm-asahi
# 10), the J413 speaker and mic graphs (asahi-audio 4.1), and the macaudio
# sense interface with per-model profiles (speakersafetyd 2.0).
Requires:       alsa-ucm-asahi >= 10
Requires:       asahi-audio >= 4.1
Requires:       speakersafetyd >= 2.0.1
Requires(post): sed
# Replace Gravity's forks of the three packages, which carried these files,
# with Fedora's builds. Their releases (10x.gravity) sort above Fedora's, so
# without this dnf would keep them. A Conflicts alone is not enough: dnf
# upgrade skips this package instead of downgrading the forks. Each Obsoletes
# names one fork build exactly, so Fedora's builds of the same names stay
# installable.
Obsoletes:      alsa-ucm-asahi = 10-100.gravity%{?dist}
Obsoletes:      alsa-ucm-asahi = 10-101.gravity%{?dist}
Obsoletes:      alsa-ucm-asahi = 10-102.gravity%{?dist}
Obsoletes:      asahi-audio = 4.1-100.gravity%{?dist}
Obsoletes:      asahi-audio = 4.1-101.gravity%{?dist}
Obsoletes:      speakersafetyd = 2.0.1-100.gravity%{?dist}
Conflicts:      gravity-alsa-ucm-asahi
Conflicts:      gravity-asahi-audio
Conflicts:      gravity-speakersafetyd

%description
ALSA UCM profiles (speakers, headphones and internal microphones), PipeWire
DSP rules and the speakersafetyd speaker-protection profile for the MacBook
Air 13" (M4, J713). The speakers and microphones use asahi-audio's J413 graphs,
as asahi-audio does for the J613.

%prep
%setup -c -T
cp -p %{sources} .

%build

%install
ucm=%{buildroot}%{_datadir}/alsa/ucm2/conf.d
install -Dpm0644 macaudio-j713.conf "$ucm/macaudio/MacBook Air J713.conf"
install -Dpm0644 macaudio-j713-HiFi.conf $ucm/macaudio/j713/HiFi.conf
install -Dpm0644 macaudio-j713-Headphones.conf $ucm/macaudio/j713/Headphones.conf
install -Dpm0644 aop_audio-j713.conf "$ucm/aop_audio/MacBook Air J713 High-Power Audio Interface.conf"
install -Dpm0644 wireplumber-j713.conf %{buildroot}%{_datadir}/wireplumber/wireplumber.conf.d/99-asahi-j713.conf
install -Dpm0644 speakersafetyd-j713.conf %{buildroot}%{_datadir}/speakersafetyd/apple/j713.conf
install -Dpm0644 95-speakersafetyd-j713.rules %{buildroot}%{_udevrulesdir}/95-speakersafetyd-j713.rules
# Generated by the asahi-audio trigger below
install -dm0755 %{buildroot}%{_datadir}/asahi-audio/j413
touch %{buildroot}%{_datadir}/asahi-audio/j413/graph-j713.json
touch %{buildroot}%{_datadir}/asahi-audio/j413/mic-j713.json

# Derive the J713 graphs from the installed J413 ones with asahi-audio's own
# alias rule (its Makefile builds graph-j613.json and mic-j613.json the same
# way), so they follow every asahi-audio update.
%triggerin -- asahi-audio
dir=%{_datadir}/asahi-audio/j413
for graph in graph mic; do
    if [ -f "$dir/$graph.json" ]; then
        sed -E 's/([^/][jJ])413/\1713/g' "$dir/$graph.json" >"$dir/$graph-j713.json.tmp" &&
            mv -f "$dir/$graph-j713.json.tmp" "$dir/$graph-j713.json" ||
            rm -f "$dir/$graph-j713.json.tmp"
    fi
done
exit 0

%files
%license LICENSE LICENSE.alsa-ucm-conf-asahi
%doc README.md
"%{_datadir}/alsa/ucm2/conf.d/macaudio/MacBook Air J713.conf"
%{_datadir}/alsa/ucm2/conf.d/macaudio/j713/
"%{_datadir}/alsa/ucm2/conf.d/aop_audio/MacBook Air J713 High-Power Audio Interface.conf"
%{_datadir}/wireplumber/wireplumber.conf.d/99-asahi-j713.conf
%ghost %{_datadir}/asahi-audio/j413/graph-j713.json
%ghost %{_datadir}/asahi-audio/j413/mic-j713.json
%{_datadir}/speakersafetyd/apple/j713.conf
%{_udevrulesdir}/95-speakersafetyd-j713.rules

