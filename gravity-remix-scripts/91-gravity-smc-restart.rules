# On the MacBook Air (M4), a restart or power-off through the SMC leaves the
# trackpad's touch controller unable to start on the next boot unless the
# kernel resets the controller through its reset line (kernel 7.3.0-519 and
# later on the 13-inch model). The helper detaches the SMC reboot driver when
# the running device tree lacks that line, so restart goes through the
# watchdog as on earlier kernels (Shut Down then halts without cutting power).
ACTION=="add|bind", SUBSYSTEM=="platform", KERNEL=="macsmc-reboot", RUN+="/usr/libexec/gravity-remix-scripts/smc-restart-quirk"
