#
# Gravity sleep policy: leave systemd's default sleep configuration alone on
# machines that support suspend-to-idle with the running kernel, and mask the
# sleep targets everywhere else, the way the systemd.mask= kernel argument
# does. logind then reports CanSuspend=no, desktops do not offer sleep, and
# suspend requests are refused before anything is frozen.
#
# Turn the policy off (allow sleep everywhere):
#   ln -s /dev/null /etc/systemd/system-generators/gravity-sleep-generator
# Block sleep on a supported machine:
#   systemctl mask suspend.target

normal_dir=${1:?usage: gravity-sleep-generator NORMAL_DIR [EARLY_DIR LATE_DIR]}
sysroot=${GRAVITY_SLEEP_SYSROOT:-}

s2idle_supported() {
	# The board's drivers keep storage, USB and Bluetooth working across
	# suspend-to-idle. Only the MacBook Air (J713) does so far; other boards
	# take resume paths that have not been made to work yet.
	grep -qzx 'apple,j713' "$sysroot/proc/device-tree/compatible" 2>/dev/null || return 1
	# The CPU idle driver can power CPUs down in suspend-to-idle. Without
	# it the kernel would idle them in a state that loses their registers.
	for state in "$sysroot"/sys/devices/system/cpu/cpu0/cpuidle/state*/s2idle; do
		[ -d "$state" ] && return 0
	done
	return 1
}

s2idle_supported && exit 0
for target in suspend hibernate hybrid-sleep suspend-then-hibernate; do
	ln -sf /dev/null "$normal_dir/$target.target"
done
