#!/bin/sh
# Run by 91-gravity-smc-restart.rules when the SMC reboot device appears or
# its driver binds. Detaches the driver on the 13- and 15-inch MacBook Air (M4)
# when the running kernel's device tree does not connect the trackpad
# controller's reset line.
dt=/proc/device-tree
tr '\0' '\n' < "$dt/compatible" 2>/dev/null | grep -qxE 'apple,j71[35]' || exit 0
# With the reset line the kernel resets the controller at every start, so a
# restart or power-off through the SMC is safe.
# /proc/device-tree is a symbolic link: the trailing slash makes find enter it.
for node in $(find "$dt/" -type d -name multi-touch 2>/dev/null); do
	[ -e "$node/reset-gpios" ] && exit 0
done
drv=/sys/bus/platform/drivers/macsmc-reboot
[ -e "$drv/macsmc-reboot" ] || exit 0
echo macsmc-reboot > "$drv/unbind" || exit 1
echo "gravity: SMC restart and power-off are off on this model; restart uses the watchdog" > /dev/kmsg
