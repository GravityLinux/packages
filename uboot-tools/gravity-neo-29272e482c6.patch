diff --git a/include/apple_tunable.h b/include/apple_tunable.h
new file mode 100644
index 0000000000000000000000000000000000000000..b8abc9485e5d45e8d278174db0c161edb9617cbe
--- /dev/null
+++ b/include/apple_tunable.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Apple DT tunable triples, as used by Linux drivers/soc/apple/tunable.c. */
+#ifndef _APPLE_TUNABLE_H
+#define _APPLE_TUNABLE_H
+
+#include <dm/device.h>
+#include <dm/read.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+
+static inline int apple_tunable_apply(struct udevice *dev, const char *property,
+				      void __iomem *base, size_t size)
+{
+	const fdt32_t *values;
+	int length, i;
+
+	values = dev_read_prop(dev, property, &length);
+	if (!values)
+		return 0;
+	if (size < sizeof(u32) || length % (3 * sizeof(u32)))
+		return -EINVAL;
+	/* Validate the entire table before writing any registers. */
+	for (i = 0; i < length / sizeof(*values); i += 3) {
+		u32 offset = fdt32_to_cpu(values[i]);
+
+		if (offset % sizeof(u32) || offset > size - sizeof(u32) ||
+		    (fdt32_to_cpu(values[i + 2]) &
+		     ~fdt32_to_cpu(values[i + 1])))
+			return -EINVAL;
+	}
+	for (i = 0; i < length / sizeof(*values); i += 3) {
+		u32 offset = fdt32_to_cpu(values[i]);
+		u32 mask = fdt32_to_cpu(values[i + 1]);
+		u32 value = fdt32_to_cpu(values[i + 2]);
+		u32 old = readl(base + offset);
+		u32 next = (old & ~mask) | value;
+
+		if (next != old)
+			writel(next, base + offset);
+	}
+	return 0;
+}
+#endif

