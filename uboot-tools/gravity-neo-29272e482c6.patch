diff --git a/drivers/phy/phy-apple-atc-t8130.c b/drivers/phy/phy-apple-atc-t8130.c
new file mode 100644
index 0000000000000000000000000000000000000000..dee66ed854d2da124f9bb8082bb870b17164437f
--- /dev/null
+++ b/drivers/phy/phy-apple-atc-t8130.c
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * T8130-generation ATC shared USB2 host path.
+ * Ported from the Gravity Linux Apple ATC driver, a0126e397483.
+ * Copyright The Asahi Linux Contributors
+ * Copyright 2026 Cody Ho
+ */
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <generic-phy.h>
+#include <reset-uclass.h>
+#include <apple_tunable.h>
+#include <asm/io.h>
+#include <dt-bindings/phy/phy.h>
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+
+/* pipehandler registers */
+#define PIPEHANDLER_OVERRIDE 0x00
+#define PIPEHANDLER_OVERRIDE_RXVALID BIT(0)
+#define PIPEHANDLER_OVERRIDE_RXDETECT BIT(2)
+#define PIPEHANDLER_OVERRIDE_VALUES 0x04
+#define PIPEHANDLER_OVERRIDE_VAL_RXDETECT0 BIT(1)
+#define PIPEHANDLER_OVERRIDE_VAL_RXDETECT1 BIT(2)
+
+#define PIPEHANDLER_MUX_CTRL 0x0c
+#define PIPEHANDLER_MUX_CTRL_CLK GENMASK(5, 3)
+#define PIPEHANDLER_MUX_CTRL_DATA GENMASK(2, 0)
+#define PIPEHANDLER_MUX_CTRL_CLK_OFF 0
+#define PIPEHANDLER_MUX_CTRL_CLK_DUMMY 4
+
+#define PIPEHANDLER_MUX_CTRL_DATA_DUMMY 2
+
+#define PIPEHANDLER_LOCK_REQ 0x10
+#define PIPEHANDLER_LOCK_ACK 0x14
+#define PIPEHANDLER_LOCK_EN BIT(0)
+
+#define PIPEHANDLER_AON_GEN 0x1C
+#define PIPEHANDLER_AON_GEN_DWC3_FORCE_CLAMP_EN BIT(4)
+#define PIPEHANDLER_AON_GEN_DWC3_RESET_N BIT(0)
+
+#define PIPEHANDLER_NONSELECTED_OVERRIDE 0x20
+#define PIPEHANDLER_DUMMY_PHY_EN BIT(15)
+#define PIPEHANDLER_NATIVE_RESET BIT(12)
+#define PIPEHANDLER_NATIVE_POWER_DOWN GENMASK(3, 0)
+
+#define T8130_PIPEHANDLER_LOCK_ACK_TIMEOUT_US 10000
+
+/* T8130 PIPE clock-block configuration, observed in both native USB2-only
+ * and USB3 host startup. The individual fields are not decoded yet: these
+ * labels identify registers and captured defaults, not inferred bit meanings.
+ */
+#define T8130_PIPE_CLOCK_CFG0 0x80
+#define T8130_PIPE_CLOCK_CFG1 0x84
+#define T8130_PIPE_CLOCK_CFG2 0x88
+#define T8130_PIPE_CLOCK_CFG3 0x8c
+#define T8130_PIPE_CLOCK_CFG0_NATIVE 0x17
+#define T8130_PIPE_CLOCK_CFG1_NATIVE 0xc8
+#define T8130_PIPE_CLOCK_CFG2_NATIVE 0x5
+#define T8130_PIPE_CLOCK_CFG3_NATIVE 0x5
+
+#define USB2PHY_USBCTL 0x00
+#define USB2PHY_USBCTL_USB_MODE 0x7
+#define USB2PHY_USBCTL_RUN 2
+#define USB2PHY_USBCTL_ISOLATION 4
+
+#define USB2PHY_CTL 0x04
+#define USB2PHY_CTL_RESET BIT(0)
+#define USB2PHY_CTL_PORT_RESET BIT(1)
+#define USB2PHY_CTL_APB_RESET_N BIT(2)
+#define USB2PHY_CTL_SIDDQ BIT(3)
+
+#define USB2PHY_SIG 0x08
+#define USB2PHY_SIG_VBUSDET_FORCE_VAL BIT(0)
+#define USB2PHY_SIG_VBUSDET_FORCE_EN BIT(1)
+#define USB2PHY_SIG_VBUSVLDEXT_FORCE_VAL BIT(2)
+#define USB2PHY_SIG_VBUSVLDEXT_FORCE_EN BIT(3)
+#define USB2PHY_SIG_HOST (7 << 12)
+
+#define USB2PHY_MISCTUNE 0x1c
+#define USB2PHY_MISCTUNE_APBCLK_GATE_OFF BIT(29)
+#define USB2PHY_MISCTUNE_REFCLK_GATE_OFF BIT(30)
+
+#define ATCPHY_SETTLE_US 10
+
+struct apple_atc_t8130 {
+	void __iomem *usb2;
+	void __iomem *pipe;
+	void __iomem *clocks;
+	size_t pipe_size;
+	bool usb2_up;
+};
+
+static void atc_usb2_off(struct apple_atc_t8130 *atc)
+{
+	clrsetbits_le32(atc->usb2 + USB2PHY_USBCTL, USB2PHY_USBCTL_USB_MODE,
+			USB2PHY_USBCTL_ISOLATION);
+	udelay(ATCPHY_SETTLE_US);
+	setbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_SIDDQ);
+	udelay(ATCPHY_SETTLE_US);
+	setbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_PORT_RESET);
+	udelay(ATCPHY_SETTLE_US);
+	setbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_RESET);
+	udelay(ATCPHY_SETTLE_US);
+	clrbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_APB_RESET_N);
+	udelay(ATCPHY_SETTLE_US);
+	setbits_le32(atc->usb2 + USB2PHY_MISCTUNE,
+		     USB2PHY_MISCTUNE_APBCLK_GATE_OFF |
+			     USB2PHY_MISCTUNE_REFCLK_GATE_OFF);
+	atc->usb2_up = false;
+}
+
+static void atc_usb2_on(struct apple_atc_t8130 *atc)
+{
+	if (atc->usb2_up)
+		return;
+	setbits_le32(atc->usb2 + USB2PHY_SIG,
+		USB2PHY_SIG_VBUSDET_FORCE_VAL | USB2PHY_SIG_VBUSDET_FORCE_EN |
+			USB2PHY_SIG_VBUSVLDEXT_FORCE_VAL |
+			USB2PHY_SIG_VBUSVLDEXT_FORCE_EN | USB2PHY_SIG_HOST);
+	udelay(ATCPHY_SETTLE_US);
+	clrbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_SIDDQ);
+	udelay(ATCPHY_SETTLE_US);
+	clrbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_RESET);
+	udelay(ATCPHY_SETTLE_US);
+	clrbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_PORT_RESET);
+	udelay(ATCPHY_SETTLE_US);
+	setbits_le32(atc->usb2 + USB2PHY_CTL, USB2PHY_CTL_APB_RESET_N);
+	udelay(ATCPHY_SETTLE_US);
+	clrbits_le32(atc->usb2 + USB2PHY_MISCTUNE,
+		     USB2PHY_MISCTUNE_APBCLK_GATE_OFF |
+			     USB2PHY_MISCTUNE_REFCLK_GATE_OFF);
+	writel(USB2PHY_USBCTL_RUN, atc->usb2 + USB2PHY_USBCTL);
+	atc->usb2_up = true;
+}
+
+static int atc_dummy(struct apple_atc_t8130 *atc)
+{
+	u32 value;
+	int ret;
+	bool running = readl(atc->pipe + PIPEHANDLER_AON_GEN) &
+		       PIPEHANDLER_AON_GEN_DWC3_RESET_N;
+
+	clrbits_le32(atc->pipe + PIPEHANDLER_OVERRIDE_VALUES,
+		     PIPEHANDLER_OVERRIDE_VAL_RXDETECT0 |
+			     PIPEHANDLER_OVERRIDE_VAL_RXDETECT1);
+	setbits_le32(atc->pipe + PIPEHANDLER_OVERRIDE,
+		     PIPEHANDLER_OVERRIDE_RXVALID |
+			     PIPEHANDLER_OVERRIDE_RXDETECT);
+	setbits_le32(atc->pipe + PIPEHANDLER_NONSELECTED_OVERRIDE,
+		     PIPEHANDLER_DUMMY_PHY_EN);
+	if (running) {
+		setbits_le32(atc->pipe + PIPEHANDLER_LOCK_REQ,
+			     PIPEHANDLER_LOCK_EN);
+		ret = readl_poll_timeout(atc->pipe + PIPEHANDLER_LOCK_ACK,
+					 value, value & PIPEHANDLER_LOCK_EN,
+					 T8130_PIPEHANDLER_LOCK_ACK_TIMEOUT_US);
+		if (ret) {
+			clrbits_le32(atc->pipe + PIPEHANDLER_LOCK_REQ,
+				     PIPEHANDLER_LOCK_EN);
+			return ret;
+		}
+	}
+	clrsetbits_le32(atc->pipe + PIPEHANDLER_MUX_CTRL,
+			PIPEHANDLER_MUX_CTRL_CLK,
+			FIELD_PREP(PIPEHANDLER_MUX_CTRL_CLK,
+				   PIPEHANDLER_MUX_CTRL_CLK_OFF));
+	udelay(ATCPHY_SETTLE_US);
+	clrsetbits_le32(atc->pipe + PIPEHANDLER_MUX_CTRL,
+			PIPEHANDLER_MUX_CTRL_DATA,
+			FIELD_PREP(PIPEHANDLER_MUX_CTRL_DATA,
+				   PIPEHANDLER_MUX_CTRL_DATA_DUMMY));
+	udelay(ATCPHY_SETTLE_US);
+	clrsetbits_le32(atc->pipe + PIPEHANDLER_MUX_CTRL,
+			PIPEHANDLER_MUX_CTRL_CLK,
+			FIELD_PREP(PIPEHANDLER_MUX_CTRL_CLK,
+				   PIPEHANDLER_MUX_CTRL_CLK_DUMMY));
+	udelay(ATCPHY_SETTLE_US);
+	clrsetbits_le32(atc->pipe + PIPEHANDLER_NONSELECTED_OVERRIDE,
+			PIPEHANDLER_NATIVE_POWER_DOWN,
+			PIPEHANDLER_NATIVE_RESET |
+				FIELD_PREP(PIPEHANDLER_NATIVE_POWER_DOWN, 2));
+	if (!running)
+		return 0;
+	clrbits_le32(atc->pipe + PIPEHANDLER_LOCK_REQ, PIPEHANDLER_LOCK_EN);
+	return readl_poll_timeout(atc->pipe + PIPEHANDLER_LOCK_ACK, value,
+				  !(value & PIPEHANDLER_LOCK_EN),
+				  T8130_PIPEHANDLER_LOCK_ACK_TIMEOUT_US);
+}
+
+static int atc_reset_xlate(struct reset_ctl *ctl,
+			   struct ofnode_phandle_args *args)
+{
+	return args->args_count ? -EINVAL : 0;
+}
+
+static int atc_assert(struct reset_ctl *ctl)
+{
+	struct apple_atc_t8130 *atc = dev_get_priv(ctl->dev);
+	int ret;
+
+	clrbits_le32(atc->pipe + PIPEHANDLER_AON_GEN,
+		     PIPEHANDLER_AON_GEN_DWC3_RESET_N);
+	setbits_le32(atc->pipe + PIPEHANDLER_AON_GEN,
+		     PIPEHANDLER_AON_GEN_DWC3_FORCE_CLAMP_EN);
+	ret = atc_dummy(atc);
+	atc_usb2_off(atc);
+	return ret;
+}
+
+static int atc_deassert(struct reset_ctl *ctl)
+{
+	struct apple_atc_t8130 *atc = dev_get_priv(ctl->dev);
+
+	atc_usb2_on(atc);
+	writel(T8130_PIPE_CLOCK_CFG0_NATIVE,
+	       atc->clocks + T8130_PIPE_CLOCK_CFG0);
+	writel(T8130_PIPE_CLOCK_CFG1_NATIVE,
+	       atc->clocks + T8130_PIPE_CLOCK_CFG1);
+	writel(T8130_PIPE_CLOCK_CFG2_NATIVE,
+	       atc->clocks + T8130_PIPE_CLOCK_CFG2);
+	writel(T8130_PIPE_CLOCK_CFG3_NATIVE,
+	       atc->clocks + T8130_PIPE_CLOCK_CFG3);
+	clrbits_le32(atc->pipe + PIPEHANDLER_AON_GEN,
+		     PIPEHANDLER_AON_GEN_DWC3_FORCE_CLAMP_EN);
+	setbits_le32(atc->pipe + PIPEHANDLER_AON_GEN,
+		     PIPEHANDLER_AON_GEN_DWC3_RESET_N);
+	return apple_tunable_apply(ctl->dev, "apple,tunable-pipehandler",
+				   atc->pipe, atc->pipe_size);
+}
+
+static int atc_phy_xlate(struct phy *phy, struct ofnode_phandle_args *args)
+{
+	if (args->args_count != 1 ||
+	    (args->args[0] != PHY_TYPE_USB2 && args->args[0] != PHY_TYPE_USB3))
+		return -EINVAL;
+	phy->id = args->args[0];
+	return 0;
+}
+
+static int atc_phy_on(struct phy *phy)
+{
+	struct apple_atc_t8130 *atc = dev_get_priv(phy->dev->parent);
+
+	if (phy->id == PHY_TYPE_USB2)
+		atc_usb2_on(atc);
+	/* USB3 remains on the dummy backend until Type-C negotiates a link. */
+	return 0;
+}
+
+static int atc_phy_off(struct phy *phy)
+{
+	struct apple_atc_t8130 *atc = dev_get_priv(phy->dev->parent);
+
+	if (phy->id == PHY_TYPE_USB2)
+		atc_usb2_off(atc);
+	return 0;
+}
+
+static const struct phy_ops atc_phy_ops = {
+	.of_xlate = atc_phy_xlate,
+	.power_on = atc_phy_on,
+	.power_off = atc_phy_off,
+};
+
+static struct driver atc_phy_driver = {
+	.name = "apple-atc-t8130-phy",
+	.id = UCLASS_PHY,
+	.ops = &atc_phy_ops,
+};
+
+static int atc_probe(struct udevice *dev)
+{
+	struct apple_atc_t8130 *atc = dev_get_priv(dev);
+	struct udevice *child;
+	fdt_addr_t addr;
+	fdt_size_t size;
+
+	addr = dev_read_addr_size_name(dev, "usb2phy", &size);
+	if (addr == FDT_ADDR_T_NONE || size < USB2PHY_MISCTUNE + sizeof(u32))
+		return -EINVAL;
+	atc->usb2 = (void __iomem *)addr;
+	addr = dev_read_addr_size_name(dev, "pipehandler", &size);
+	if (addr == FDT_ADDR_T_NONE ||
+	    size < PIPEHANDLER_NONSELECTED_OVERRIDE + sizeof(u32))
+		return -EINVAL;
+	atc->pipe = (void __iomem *)addr;
+	atc->pipe_size = size;
+	addr = dev_read_addr_size_name(dev, "pipe-clocks", &size);
