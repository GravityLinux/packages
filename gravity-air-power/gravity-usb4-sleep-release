"""Re-run the closed-lid sleep action after a USB4 link goes away.

Runs when gravity-usb4-sleep-inhibit@.service stops, with the USB4 domain's
sysfs path. While the lid is closed, systemd-logind re-checks the lid by
itself once the inhibitor is released, but a desktop that handles the lid
(KDE PowerDevil holds a handle-lid-switch inhibitor) only acts on lid
changes. If PowerDevil's lid action is sleep, ask it to suspend, as it
would have done on lid close. Nothing happens while the link is still up,
while the lid is open, while something else blocks sleep, or during
shutdown.

  gravity-usb4-sleep-release [--dry-run] DOMAIN_SYSFS_PATH
"""
import json, os, pwd, shlex, subprocess, sys, time
from pathlib import Path

LOGIN = ['org.freedesktop.login1', '/org/freedesktop/login1', 'org.freedesktop.login1.Manager']
PD = 'org.kde.Solid.PowerManagement'
PD_ACTIONS = '/org/kde/Solid/PowerManagement/Actions/'
PD_SLEEP = 1  # PowerDevil::PowerButtonAction::Sleep


def user_bus(pw):
    """Run busctl as the user, connected to their session bus socket.

    busctl --user --machine=USER@ goes through systemd-run instead: a
    transient system unit with a PAM login session for every call. At a real
    USB4 removal that failed without PID 1 starting the unit. The socket
    needs no unit, PAM or logind session.
    """
    rt = '/run/user/%d' % pw.pw_uid
    return dict(user=pw.pw_uid, group=pw.pw_gid, extra_groups=os.getgrouplist(pw.pw_name, pw.pw_gid),
                cwd='/', env={'PATH': '/usr/bin', 'XDG_RUNTIME_DIR': rt,
                              'DBUS_SESSION_BUS_ADDRESS': 'unix:path=%s/bus' % rt})


def busctl(*args, user=None):
    cmd = ['busctl', '--json=short', '--timeout=5'] + (['--user'] if user else []) + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=15, **(user_bus(user) if user else {}))
    r.check_returncode()
    return json.loads(r.stdout)['data'] if r.stdout.strip() else None


def describe(e):
    if isinstance(e, subprocess.CalledProcessError):
        err = (e.stderr or '').strip() or 'no error output'
        return '%s exited with status %d: %s' % (shlex.join(e.cmd), e.returncode, err)
    return str(e)


def log(msg):
    print('gravity-usb4-sleep-release: ' + msg, flush=True)


def main(argv):
    dry = '--dry-run' in argv
    paths = [a for a in argv if not a.startswith('--')]
    if len(paths) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    if Path(paths[0]).exists():
        log(paths[0] + ' still exists: the USB4 link is up, nothing to re-check')
        return 0
    state = subprocess.run(['systemctl', 'is-system-running'], capture_output=True, text=True).stdout.strip()
    if state == 'stopping':
        return 0
    # logind drops the released inhibitor asynchronously.
    for _ in range(30):
        blocked = busctl('get-property', *LOGIN, 'BlockInhibited').split(':')
        if 'sleep' not in blocked:
            break
        time.sleep(0.1)
    else:
        log('sleep is still blocked by another inhibitor')
        return 0
    if not busctl('get-property', *LOGIN, 'LidClosed'):
        return 0
    holders = [i for i in busctl('call', *LOGIN, 'ListInhibitors')[0]
               if i[3] == 'block' and 'handle-lid-switch' in i[0].split(':')]
    if not holders:
        log('lid closed; systemd-logind handles the lid and re-checks it')
        return 0
    for what, who, why, mode, uid, pid in holders:
        if who != 'PowerDevil':
            log('lid closed; the lid is handled by %s (uid %d), not re-triggered' % (who, uid))
            continue
        user = pwd.getpwuid(uid)
        iface = PD + '.Actions.HandleButtonEvents'
        action = busctl('call', PD, PD_ACTIONS + 'HandleButtonEvents', iface, 'lidAction', user=user)[0]
        triggers = busctl('call', PD, PD_ACTIONS + 'HandleButtonEvents', iface, 'triggersLidAction', user=user)[0]
        if action != PD_SLEEP or not triggers:
            log('lid closed; PowerDevil (%s) lid action %d, external-monitor gate %s: nothing to do'
                % (user.pw_name, action, 'open' if triggers else 'closed'))
            continue
        log('lid closed and the USB4 link is gone: asking PowerDevil (%s) to suspend%s'
            % (user.pw_name, ' [dry run]' if dry else ''))
        if not dry:
            busctl('call', PD, PD_ACTIONS + 'SuspendSession', PD + '.Actions.SuspendSession',
                   'suspendToRam', user=user)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError) as e:
        log('not re-checked: ' + describe(e))
        raise SystemExit(0)
