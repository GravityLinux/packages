"""Enable suspend-to-idle on the J713 Air when the running kernel supports it.

Gravity's vendor policy disables sleep on every board. On a J713 whose kernel
provides CPU power-down for s2idle, write runtime overrides under /run that
allow suspend (s2idle only), select suspend for the lid, and let
systemd-suspend.service run again after a per-call --check (eligible, and
the overrides are in place). --eligible only tests the board and kernel;
--disable removes the overrides. Every other board
and kernel keeps the vendor no-sleep policy. The kernel argument
gravity.air_s2idle=0 keeps it too.
"""
from pathlib import Path
import sys, shutil, subprocess

LOGIND = '# Managed by Gravity Air s2idle\n[Login]\nHandleLidSwitch=suspend\nHandleLidSwitchDocked=suspend\nHandleSuspendKey=suspend\n'
SLEEP = '# Managed by Gravity Air s2idle\n[Sleep]\nAllowSuspend=yes\nSuspendState=freeze\nMemorySleepMode=s2idle\n'
SERVICE = '# Managed by Gravity Air s2idle\n[Service]\nExecCondition=\nExecCondition=/usr/libexec/gravity-air-s2idle-default --check\n'
SLEEP_FILE = '/run/systemd/sleep.conf.d/99-gravity-air-s2idle.conf'
FILES = {'/run/systemd/logind.conf.d/99-gravity-air-s2idle.conf': LOGIND,
         SLEEP_FILE: SLEEP,
         '/run/systemd/system/systemd-suspend.service.d/99-gravity-air-s2idle.conf': SERVICE}


def eligible(root=Path('/')):
    def read(path):
        return (root / path.lstrip('/')).read_text().strip()
    try:
        return (b'apple,j713\0' in (root/'proc/device-tree/compatible').read_bytes()
                and 'gravity.air_s2idle=0' not in read('/proc/cmdline').split()
                # The kernel's s2idle support: CPU power-down implements
                # enter_s2idle (older kernels have no such directory).
                and (root/'sys/devices/system/cpu/cpu0/cpuidle/state1/s2idle/usage').exists()
                and 's2idle' in read('/sys/power/mem_sleep'))
    except OSError:
        return False


def active(root=Path('/')):
    """The policy is in effect for this boot: eligible, and its overrides written."""
    p = root / SLEEP_FILE.lstrip('/')
    try:
        return eligible(root) and p.read_text() == SLEEP
    except OSError:
        return False


def main():
    if '--disable' in sys.argv:
        for name, text in FILES.items():
            p = Path(name)
            if p.exists() and p.read_text() == text:
                p.unlink()
        return 0
    if '--check' in sys.argv:
        return 0 if active() else 1
    if '--eligible' in sys.argv:
        return 0 if eligible() else 1
    if not eligible():
        print('Gravity Air s2idle: not a J713 with kernel s2idle support; keeping the no-sleep policy')
        return 1
    for name, text in FILES.items():
        p = Path(name); p.parent.mkdir(parents=True, exist_ok=True)
        q = p.with_suffix('.new'); q.write_text(text); q.chmod(0o644); q.replace(p)
        # Newly created /run directories otherwise inherit init_var_run_t.
        # systemd-sleep must be able to read its systemd_conf_t overrides.
        restorecon = shutil.which('restorecon')
        if restorecon:
            subprocess.run([restorecon, '-F', str(p.parent), str(p)], check=True)
        elif Path('/sys/fs/selinux/enforce').exists():
            raise RuntimeError('SELinux is enabled but restorecon is unavailable')
    print('Gravity Air s2idle: lid suspend enabled')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
