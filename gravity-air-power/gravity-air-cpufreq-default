# The fanless J713 keeps turbo available as an explicit runtime opt-in.
set -eu
if ! grep -zFxq 'apple,j713' /sys/firmware/devicetree/base/compatible; then
    exit 0
fi
boost=/sys/devices/system/cpu/cpufreq/boost
printf '0\n' > "$boost"
test "$(cat "$boost")" = 0
echo 'J713 cpufreq boost default: 0 (runtime opt-in remains available)'
for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    printf '%s: max_khz=%s\n' "${policy##*/}" "$(cat "$policy/scaling_max_freq")"
done
