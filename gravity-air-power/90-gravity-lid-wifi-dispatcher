#!/bin/sh
# Reapply after NetworkManager restores firmware settings on reconnect.
case "$2" in up|dhcp4-change|dhcp6-change|reapply)
    [ -e "/sys/class/net/$1/phy80211" ] || exit 0
    systemctl --quiet is-active gravity-lid-wifi.service || exit 0
    systemctl kill --kill-whom=main --signal=HUP gravity-lid-wifi.service || :
    ;;
esac
